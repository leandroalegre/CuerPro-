# CuerPro API - Variables de entorno
# Copiar este archivo como .env y completar los valores

# Puerto del servidor Node.js (TimbreWeb usa el 3030)
PORT=3031

# Base de datos MySQL (se crea desde el panel de sistemascloud.ar)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistemacbahost_cuerpro
DB_USER=sistemacbahost_cuerpro_api
DB_PASS=CAMBIAR_PASSWORD_AQUI

# Opcional. Token de acceso de Expo para enviar las notificaciones.
# Se crea en https://expo.dev/accounts/leandroalegre/settings/access-tokens
EXPO_ACCESS_TOKEN=
