{
  "expo": {
    "name": "CuerPro",
    "slug": "cuerpro",
    "version": "0.2.3",
    "orientation": "portrait",
    "scheme": "cuerpro",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "versionCode": 5,
      "package": "ar.sistemascloud.cuerpro",
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#08090c"
      }
    },
    "ios": {
      "bundleIdentifier": "ar.sistemascloud.cuerpro",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/ionicons.ttf"]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff6b35",
          "icon": "./assets/images/notificacion.png"
        }
      ]
    ],
    "owner": "leandroalegre",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090a"
    },
    "extra": {
      "eas": {
        "projectId": "2a9af669-2ab5-44e8-8380-9106da1ce347"
      }
    }
  }
}
