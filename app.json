{
  "expo": {
    "name": "CuerPro",
    "slug": "cuerpro",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cuerpro",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "ar.sistemascloud.cuerpro",
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#08090c"
      }
    },
    "ios": {
      "bundleIdentifier": "ar.sistemascloud.cuerpro",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#ff6b35",
          "icon": "./assets/images/notificacion.png"
        }
      ]
    ],
    "owner": "leandroalegre",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090a"
    }
  }
}
